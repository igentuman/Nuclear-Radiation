{
  "targets": {
    "glow_source": {},
    "glow_final": {},
    "outline_source": {},
    "outline_edges": {},
    "outline_horizontal": {},
    "outline_blurred": {},
    "glow_down_1": {},
    "glow_down_2": {},
    "glow_down_3": {},
    "glow_down_4": {},
    "glow_down_5": {},
    "glow_up_1": {},
    "glow_up_2": {},
    "glow_up_3": {},
    "glow_up_4": {}
  },
  "passes": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_extract",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "minecraft:entity_outline"
        },
        {
          "sampler_name": "ItemDepth",
          "target": "minecraft:entity_outline",
          "use_depth_buffer": true
        },
        {
          "sampler_name": "SceneDepth",
          "target": "minecraft:main",
          "use_depth_buffer": true
        }
      ],
      "output": "glow_source"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_source"
        }
      ],
      "output": "glow_down_1"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_down_1"
        }
      ],
      "output": "glow_down_2"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_down_2"
        }
      ],
      "output": "glow_down_3"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_down_3"
        }
      ],
      "output": "glow_down_4"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_down_4"
        }
      ],
      "output": "glow_down_5"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_upsample",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_down_5"
        },
        {
          "sampler_name": "Detail",
          "target": "glow_down_4"
        }
      ],
      "output": "glow_up_4"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_upsample",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_up_4"
        },
        {
          "sampler_name": "Detail",
          "target": "glow_down_3"
        }
      ],
      "output": "glow_up_3"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_upsample",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_up_3"
        },
        {
          "sampler_name": "Detail",
          "target": "glow_down_2"
        }
      ],
      "output": "glow_up_2"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_upsample",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "glow_up_2"
        },
        {
          "sampler_name": "Detail",
          "target": "glow_down_1"
        }
      ],
      "output": "glow_up_1"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_composite",
      "inputs": [
        {
          "sampler_name": "Glow",
          "target": "glow_up_1"
        },
        {
          "sampler_name": "Mask",
          "target": "glow_source"
        }
      ],
      "output": "glow_final",
      "uniforms": {
        "GlowConfig": [
          {
            "name": "Boost",
            "type": "float",
            "value": 1.0
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_outline_extract",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "minecraft:entity_outline"
        }
      ],
      "output": "outline_source"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/entity_sobel",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "outline_source"
        }
      ],
      "output": "outline_edges"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/entity_outline_box_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "outline_edges",
          "bilinear": true
        }
      ],
      "output": "outline_horizontal",
      "uniforms": {
        "BlurConfig": [
          {
            "name": "BlurDir",
            "type": "vec2",
            "value": [
              1.0,
              0.0
            ]
          },
          {
            "name": "Radius",
            "type": "float",
            "value": 2.0
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/entity_outline_box_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "outline_horizontal",
          "bilinear": true
        }
      ],
      "output": "outline_blurred",
      "uniforms": {
        "BlurConfig": [
          {
            "name": "BlurDir",
            "type": "vec2",
            "value": [
              0.0,
              1.0
            ]
          },
          {
            "name": "Radius",
            "type": "float",
            "value": 2.0
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "nuclear_radiation:post/ionization_glow_merge",
      "inputs": [
        {
          "sampler_name": "Outline",
          "target": "outline_blurred"
        },
        {
          "sampler_name": "Glow",
          "target": "glow_final"
        }
      ],
      "output": "minecraft:entity_outline"
    }
  ]
}
